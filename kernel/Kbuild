obj-m += yukizygisk.o

yukizygisk-objs := \
	core/module.o \
	core/module_sysfs.o \
	core/bootstrap.o \
	core/control.o \
	core/auth.o \
	core/viola_shared.o \
	core/viola_monocypher.o \
	core/viola_ed25519.o \
	host/runtime.o \
	host/root_impl.o \
	host/mount.o \
	host/policy.o \
	host/inode.o \
	host/policy_temp.o \
	host/patch_text.o \
	host/lsm.o \
	host/adapter.o \
	feature/config.o \
	feature/endpoint.o \
	feature/load_policy.o \
